# Which model answers: "openai" (the OPENAI_* settings) or "anthropic"
# (Claude, the ANTHROPIC_* settings). MODEL_FALLBACK, the other one or
# empty, answers when MODEL_PROVIDER fails. Every model setting is
# explained in the root .env.example.
MODEL_PROVIDER=openai
MODEL_FALLBACK=

# Any OpenAI-compatible server with tool calling (LM Studio, Ollama,
# llama.cpp, vLLM, OpenAI). The keys are secrets: set them in apps/api/.env
# (gitignored), never here.
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_THINKING=disabled
# Spend ceilings in US dollars per UTC day and calendar month; 0 is none.
MODEL_BUDGET_DAILY_USD=0
MODEL_BUDGET_MONTHLY_USD=0
# The line for the model (model_queue.py): questions answered at once (match
# LM Studio's "parallel"), questions allowed to wait, and the longest wait.
MODEL_SLOTS=4
MODEL_QUEUE_MAX=20
MODEL_QUEUE_WAIT_S=180

# CORS origin of the Next.js frontend in dev.
FRONTEND_ORIGIN=http://localhost:3000

# The STAC API the scenes come from: the public Bhoonidhi STAC API, or your
# own (see apps/api/README.md, STAC API). Empty leaves the agent without
# scene search.
STAC_API_URL=https://bhoonidhi-stac.ecotrakr.in
# The same STAC API at the address visitors' browsers reach, for the scene
# card's "STAC Item" link. Set it only when STAC_API_URL is an address this
# server alone reaches (a LAN address); empty uses STAC_API_URL.
STAC_PUBLIC_URL=

# SQLite file for saved conversations (created on first start, gitignored).
SESSIONS_DB=data/sessions.db
# Days a conversation is kept after its last activity; 0 keeps them forever.
CONVERSATION_RETENTION_DAYS=7

# Place search (@ in the palette): a Nominatim server. The public one allows at
# most one request a second from an identified app; the API caches results and
# never searches as you type. Point it at another Nominatim to switch servers.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=bhoonidhi-explorer/0.1
