# Settings for deploy/compose.yaml. Copy to .env at the repository root and
# fill in; .env is gitignored.

# --- where the explorer listens ---
EXPLORER_PORT=8080
# 127.0.0.1 accepts connections from this machine only; 0.0.0.0 lets a reverse
# proxy on another host reach it.
EXPLORER_BIND=127.0.0.1
# The image, tagged EXPLORER_TAG. Point it at a published image to skip
# building, e.g. ghcr.io/geovicco-dev/bhoonidhi-explorer with a version tag.
EXPLORER_IMAGE=bhoonidhi-explorer
EXPLORER_TAG=local

# --- the model: any OpenAI-compatible server with tool calling ---
# LM Studio, Ollama, llama.cpp, vLLM or OpenAI. host.docker.internal is the
# machine running Docker.
OPENAI_BASE_URL=http://host.docker.internal:1234/v1
# Secret. Local servers usually need none.
OPENAI_API_KEY=
OPENAI_MODEL=
# The line for the model. Questions it answers at once: match the model
# server's own limit (LM Studio's "parallel" setting). Past that, up to
# MODEL_QUEUE_MAX wait their turn, each for at most MODEL_QUEUE_WAIT_S seconds.
MODEL_SLOTS=4
MODEL_QUEUE_MAX=20
MODEL_QUEUE_WAIT_S=180

# --- the catalogue: a STAC API over Bhoonidhi's scenes ---
# The public catalogue by default. To run your own, see
# https://github.com/geovicco-dev/bhoonidhi-stac.
STAC_API_URL=https://bhoonidhi-stac.ecotrakr.in

# --- place search (@ in the palette) ---
# The public Nominatim server allows at most one request a second from an
# identified app.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=bhoonidhi-explorer/0.1

# --- conversations ---
# Days a conversation is kept after its last activity; 0 keeps them forever.
CONVERSATION_RETENTION_DAYS=7

# --- behind a reverse proxy ---
# Proxies whose X-Forwarded-For and X-Forwarded-Proto are believed, comma
# separated. Name your proxy's address here.
FORWARDED_ALLOW_IPS=127.0.0.1
# The header that carries the visitor's address, for the per-visitor limits.
# Set it only when every request passes through a proxy that writes it
# (Cf-Connecting-Ip behind Cloudflare); otherwise a visitor can send any value.
CLIENT_IP_HEADER=
