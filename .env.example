# Settings for deploy/compose.yaml. Copy to .env at the repository root and
# fill in; .env is gitignored.

# --- where the explorer listens ---
EXPLORER_PORT=8080
# 127.0.0.1 accepts connections from this machine only; 0.0.0.0 lets a reverse
# proxy on another host reach it.
EXPLORER_BIND=127.0.0.1
# The image, tagged EXPLORER_TAG. Point it at a published image to skip
# building, e.g. ghcr.io/geovicco-dev/bhoonidhi-explorer with a version tag.
EXPLORER_IMAGE=bhoonidhi-explorer
EXPLORER_TAG=local

# --- the model ---
# Which model answers: "openai" for any OpenAI-compatible server with tool
# calling (the OPENAI_* settings), "anthropic" for Claude through
# Anthropic's API (the ANTHROPIC_* settings). MODEL_FALLBACK, the other one
# or empty, answers when MODEL_PROVIDER fails: no connection, overloaded,
# rate limited, out of credit, a refused key, or a budget below reached.
MODEL_PROVIDER=openai
MODEL_FALLBACK=

# An OpenAI-compatible server: LM Studio, Ollama, llama.cpp, vLLM or
# OpenAI. host.docker.internal is the machine running Docker.
OPENAI_BASE_URL=http://host.docker.internal:1234/v1
# Secret. Local servers usually need none.
OPENAI_API_KEY=
OPENAI_MODEL=

# Claude. Secret: a key from console.anthropic.com, best in a workspace of
# its own with a spend limit.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# How hard the model works on each step (low, medium, high, xhigh, max) and
# whether it thinks first (disabled, adaptive, between_tools); empty uses
# the model's default. Not every model accepts every value.
ANTHROPIC_EFFORT=low
ANTHROPIC_THINKING=disabled
# The most one step may write, thinking included.
ANTHROPIC_MAX_TOKENS=4096
# How long the start of each request stays cached for the next step: 5m,
# 1h (cache writes cost twice as much) or off.
ANTHROPIC_CACHE_TTL=5m

# After a failure, new questions go to the fallback for this many seconds
# before MODEL_PROVIDER is tried again. With a fallback set, a provider
# silent for MODEL_FIRST_TOKEN_TIMEOUT_S seconds counts as failed.
MODEL_FALLBACK_COOLDOWN_S=300
MODEL_FIRST_TOKEN_TIMEOUT_S=20
# Spend ceilings in US dollars per UTC day and calendar month, counted from
# each answer's tokens; past one, the fallback answers until the day or
# month ends. 0 is no ceiling.
MODEL_BUDGET_DAILY_USD=0
MODEL_BUDGET_MONTHLY_USD=0
# Earlier turns replayed whole to the model; older ones keep only the
# question and the answer. 0 replays every turn whole.
MODEL_HISTORY_TURNS=0

# The line for the model. Questions it answers at once: match the model
# server's own limit (LM Studio's "parallel" setting). Past that, up to
# MODEL_QUEUE_MAX wait their turn, each for at most MODEL_QUEUE_WAIT_S seconds.
MODEL_SLOTS=4
MODEL_QUEUE_MAX=20
MODEL_QUEUE_WAIT_S=180

# --- the STAC API over Bhoonidhi's scenes ---
# The public Bhoonidhi STAC API by default. To run your own, see
# https://github.com/geovicco-dev/bhoonidhi-stac.
STAC_API_URL=https://bhoonidhi-stac.ecotrakr.in
# The same STAC API at the address visitors' browsers reach, for the scene
# card's "STAC Item" link. Set it only when STAC_API_URL is an address the
# explorer alone reaches (a LAN address); empty uses STAC_API_URL.
STAC_PUBLIC_URL=

# --- place search (@ in the palette) ---
# The public Nominatim server allows at most one request a second from an
# identified app.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=bhoonidhi-explorer/0.1

# --- conversations ---
# Days a conversation is kept after its last activity; 0 keeps them forever.
CONVERSATION_RETENTION_DAYS=7

# --- behind a reverse proxy ---
# Proxies whose X-Forwarded-For and X-Forwarded-Proto are believed, comma
# separated. Name your proxy's address here.
FORWARDED_ALLOW_IPS=127.0.0.1
# The header that carries the visitor's address, for the per-visitor limits.
# Set it only when every request passes through a proxy that writes it
# (Cf-Connecting-Ip behind Cloudflare); otherwise a visitor can send any value.
CLIENT_IP_HEADER=
